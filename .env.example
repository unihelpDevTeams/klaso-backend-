PORT=3000
FIREBASE_PROJECT_ID=vidklass

# Comma-separated allowlist; each account must verify its Firebase email.
ADMIN_EMAILS=onakomayaokiki@gmail.com

# Use a service account JSON here, or use Application Default Credentials in production.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Cloudflare R2 API credentials (create an R2 access key in the Cloudflare dashboard)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=klaso

# Public bucket URL or custom domain, without a trailing slash
R2_PUBLIC_URL=https://media.example.com

# Flutterwave Standard Checkout
FLW_PUBLIC_KEY=FLWPUBK_TEST_xxxxxxxxxxxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST_xxxxxxxxxxxxxxxxx
FLW_SECRET_HASH=your_flutterwave_webhook_hash
FLW_REDIRECT_URL=klaso://checkout

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable and backed up; changing it requires re-encrypting saved bank accounts.
BANK_ACCOUNT_ENCRYPTION_KEY=replace_with_64_hex_characters
